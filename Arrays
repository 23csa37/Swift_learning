// creating array
var numbers: [Int] = [10, 20, 30, 40]
var names = ["Arun", "Bala", "Kumar"]  // automatically identify the datatype
var numbers: [Int] = []  //empty array


// accessing the array
var numbers = [10, 20, 30, 40]
print(numbers[0])
print(numbers[1])
print(numbers[2])

//updating elements in a  array

var numbers = [10, 20, 30]
numbers[1] = 50
print(numbers)

//Array operations

var numbers = [10, 20, 30, 40]
//Check Empty
print("Is Empty:", numbers.isEmpty)

//Append
numbers.append(50)
print("After Append:", numbers)

//Insert 
numbers.insert(15, at: 1)
print("After Insert:", numbers)

//Update
numbers[2] = 25
print("After Update:", numbers)

//Remove
numbers.remove(at: 0)
print("After Remove:", numbers)

//Remove Last
numbers.removeLast()
print("After Remove Last:", numbers)

//Contains
print("Contains 30:", numbers.contains(30))
print("Contains 100:", numbers.contains(100))

//First Element
print("First Element:", numbers.first!)

//Last Element
print("Last Element:", numbers.last!)

//Minimum
print("Minimum:", numbers.min()!)

//Maximum
print("Maximum:", numbers.max()!)

//Sort
numbers.sort()
print("Ascending Order:", numbers)

//Sort
numbers.sort(by: >)
print("Descending Order:", numbers)

//Reverse
numbers.reverse()
print("Reversed Array:", numbers)

//Remove All Elements
numbers.removeAll()
print("After Remove All:", numbers)