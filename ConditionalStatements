// if condition
let age = 20
if age >= 18 {
    print("Eligible to vote")
}

//if-else
let number = 7
if number % 2 == 0 {
    print("Even Number")
} else {
    print("Odd Number")
}

//
let mark = 85
if mark >= 90 {
    print("Grade A")
} else if mark >= 75 {
    print("Grade B")
} else if mark >= 50 {
    print("Grade C")
} else {
    print("Fail")
}


//Nested-if 

let age = 22
let hasID = true

if age >= 18 {
    if hasID {
        print("Allowed")
    } else {
        print("ID required")
    }
} else {
    print("Not eligible")
}

//Switch

let day = 3
switch day {
case 1:
    print("Monday")
case 2:
    print("Tuesday")
case 3:
    print("Wednesday")
case 4:
    print("Thursday")
default:
    print("Invalid day")
}