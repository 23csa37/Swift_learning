for i in 1...10 {
    if i % 2 == 0 {
        print(i)
    }
}

//While 
var i = 1
while i <= 5 {
    print(i)
    i += 1
}

//Repeat

var i = 1
repeat {
    print(i)
    i += 1
} while i <= 5

//Stride Function
for i in stride(from: 2, through: 10, by: 2) {
    print(i)
}

//nested loops

for i in 1...3 {
    for j in 1...2 {
        print("i: \(i), j: \(j)")
    }
}